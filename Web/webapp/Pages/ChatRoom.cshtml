@page
@model webapp.Pages.ChatRoomModel
@{
}
<h4>ChatRoom (SignalR Test)</h4>
<h6>範例未啟用 Sticky Sessions, SignalR 的連線要碰運氣一下</h6>
<hr />
<div class="row">
    <div class="col-md-12">
        <form>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nickname" class="control-label"></label>
                <input asp-for="Nickname" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Message" class="control-label"></label>
                <textarea asp-for="Message" class="form-control" rows="5"></textarea>
            </div>
            <div class="form-group">
                <input type="button" id="sendButton" value="偷偷說" class="btn btn-outline-primary" />
            </div>
        </form>
    </div>
    <div class="row p-1">
        <div class="col-12">
            <hr />
        </div>
    </div>
    <div class="row p-1">
        <div class="col-12">
            <ul id="messagesList"></ul>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/lib/sgnalr/signalr.min.js"></script>
    <script src="~/js/chatroom.js"></script>
}